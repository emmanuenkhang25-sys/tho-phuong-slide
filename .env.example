# Biến môi trường — Thờ Phượng Slide
# Copy file này thành .env (apps/web/.env) và điền giá trị thật.
# KHÔNG commit file .env chứa giá trị thật.

# Supabase — lấy tại https://supabase.com/dashboard/project/<project>/settings/api
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# (Tùy chọn) Google OAuth — chỉ bật sau khi đã cấu hình trong Supabase Dashboard
# và kiểm thử đăng nhập thật. Xem docs/huong-dan-supabase.md
VITE_ENABLE_GOOGLE_LOGIN=false
